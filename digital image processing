        "import cv2\n",
        "import matplotlib.pyplot as plt\n",
        "image = cv2.imread(\"/content/brisc2025_train_03415_no_sa_t1.jpg\", cv2.IMREAD_GRAYSCALE)\n",
        "print(image.shape)\n",
        "# resize the image\n",
        "resized = cv2.resize(image,(256,256))\n",
        "print(resized.shape)\n",
        "blur = cv2.GaussianBlur(resized,(5,5),0)\n",
        "print(blur)\n",
        "\n",
        "clahe = cv2.createCLAHE(\n",
        "    clipLimit=2.0,\n",
        "    tileGridSize=(8,8)\n",
        ")\n",
        "\n",
        "enhanced = clahe.apply(blur)\n",
        "plt.imshow(enhanced, cmap=\"gray\")\n",
        "plt.title(\"Original MRI\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()\n",
        "\n",
        "normalized = enhanced / 255.0\n",
        "from skimage.feature import hog\n",
        "\n",
        "features = hog(\n",
        "    normalized,\n",
        "    orientations=9,\n",
        "    pixels_per_cell=(8,8),\n",
        "    cells_per_block=(2,2)\n",
        ")\n",
        "plt.figure(figsize=(10,5))\n",
        "\n",
        "plt.subplot(1,2,1)\n",
        "plt.imshow(image, cmap=\"gray\")\n",
        "plt.title(\"Original MRI\")\n",
        "\n",
        "plt.subplot(1,2,2)\n",
        "plt.imshow(image, cmap=\"gray\")\n",
        "plt.title(\"HOG Image\")\n",
        "\n",
        "plt.show()\n",
        "print(features)\n",
        "print(len(features))\n"
